{
  "name": "@databeez-code/ui",
  "version": "0.10.0",
  "description": "Databeez Design System — componenti React con Tailwind CSS",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./globals.css": "./globals.css",
    "./theme.css": "./theme.css",
    "./tailwind.config": "./tailwind.config.js"
  },
  "files": [
    "dist",
    "src",
    "globals.css",
    "theme.css",
    "tailwind.config.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Databeez-code/databeez-ui.git"
  },
  "scripts": {
    "build": "vite build && node scripts/build-theme-css.mjs",
    "build:theme": "node scripts/build-theme-css.mjs",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "react-day-picker": "^9.14.0",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "lucide-react": ">=0.292.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^3.3.0 || ^4"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.0-rc.12",
    "@rollup/rollup-win32-x64-msvc": "^4.60.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.0.1",
    "lucide-react": "^0.292.0",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "storybook": "^10.6.7",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  }
}
